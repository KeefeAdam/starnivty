# Frontend keys: publishable key is designed for browser use with RLS enabled
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only variables. Never prefix secrets with VITE_
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

DUITKU_MERCHANT_CODE=DXXXX
DUITKU_API_KEY=YOUR_SANDBOX_API_KEY
DUITKU_BASE_URL=https://api-sandbox.duitku.com
# Use your public Vercel deployment URL for callbacks; localhost cannot receive Duitku callbacks.
APP_BASE_URL=http://localhost:3000
